# Site options
PUBLIC_SITE_TITLE=GitBlog
PUBLIC_SITE_TAGLINE="Static publishing for product notes and experiments"
PUBLIC_SITE_DESCRIPTION="This is a static blog built with SvelteKit, GitHub Pages, and Pages CMS. Posts are managed in Markdown, and deployment is handled by GitHub Actions."
PUBLIC_SITE_OWNER="GitBlog"
PUBLIC_SITE_FOOTER="Built with SvelteKit, GitHub Pages, and Pages CMS."
PUBLIC_SITE_URL=https://blog.gitblog.app
PUBLIC_SITE_REPOSITORY=gitblogapp/svelte-gitblog-template

# Hub options
PUBLIC_HUB_ENABLED=true
PUBLIC_HUB_URL=https://gitblog.app

# Release options
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_RELEASE_USE_TRANSLATIONS=true
PUBLIC_SOURCE_LOCALE=ko
PUBLIC_TRANSLATION_LOCALES=en,ja
PUBLIC_RELEASE_LOCALE=en

# Giscus options
PUBLIC_GISCUS_REPO=gitblogapp/svelte-gitblog-template
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_HOST=https://gitblog.app
PUBLIC_GISCUS_PROVIDER=gitblog

# Social options
PUBLIC_SOCIAL_X_URL=https://x.com/gitblogapp
PUBLIC_SOCIAL_GITHUB_URL=https://github.com/gitblogapp