{
	"name": "blog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun ./scripts/validate-hub-contract.mjs && pagefind --site build",
		"preview": "bun ./scripts/preview.mjs",
		"posts:ids": "bun ./scripts/post-ids.mjs --write",
		"posts:ids:check": "bun ./scripts/post-ids.mjs --check",
		"test:site-translations": "bun ./tests/test-site-translations.mjs",
		"test:post-releases": "bun ./tests/test-post-releases.mjs",
		"test:post-ids": "bun ./tests/test-post-ids.mjs",
		"test:giscus-sync": "bun ./tests/test-giscus-sync.mjs",
		"test:hub-hints": "bun ./tests/test-hub-hints.mjs && bun ./tests/test-blog-registration.mjs",
		"hub:validate": "bun ./scripts/validate-hub-contract.mjs",
		"translate:content": "bun run posts:ids && bun ./scripts/translate-posts.mjs",
		"translate:posts": "bun run translate:content",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run test:site-translations && bun run test:post-releases && bun run test:post-ids && bun run test:giscus-sync && bun run test:hub-hints && bun run test:preservation && bun run test:extensions && bun run posts:ids:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:preservation": "bun ./tests/test-preservation.mjs",
		"test:extensions": "bun ./tests/test-extensions.ts",
		"update:check": "bun ./scripts/validate-update.mjs",
		"test:template": "bun ./tests/test-template-integration.mjs",
		"test:history": "PYTHONPATH=scripts/history python3 -m unittest discover -s tests/history -p 'test_*.py' -v"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"pagefind": "^1.5.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.11.1",
		"marked": "^18.0.0"
	}
}
